 * `fire`/`fiber` render environment for the unified rendering API.
 *
 * A page name resolves to its Sahil template under the application's
 * `resources/views/firefiber/pages` directory — `fire('dashboard')`
 * renders `firefiber.pages.dashboard`, and nested paths
 * (`fire('admin/users')`) map to subdirectories. Names that reach the
 * adapter already namespaced (`firefiber.pages.*`, `firefiber.*`)
 * resolve verbatim.
 *
 * When no page template exists, the name is treated as a component
 * reference (short or fully-qualified class) and delegated to Firefiber's
 * {@see ComponentRendererContract}, preserving the original component
 * rendering behavior. This keeps orchestration in core while rendering
 * stays in Firefiber.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:29;s:7:"endLine";i:83;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:1:{i:0;s:47:"Sahil\Contracts\Rendering\RenderAdapterContract";}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:2:{s:10:"components";a:16:{s:18:"declaringClassName";s:27:"Sahil\Firefiber\FireAdapter";s:21:"implementingClassName";s:27:"Sahil\Firefiber\FireAdapter";s:4:"name";s:10:"components";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:46:"Sahil\Contracts\View\ComponentRendererContract";s:12:"isIdentifier";b:0;}}s:7:"default";N;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:32;s:7:"endLine";i:32;s:11:"startColumn";i:9;s:9:"endColumn";i:62;s:10:"isPromoted";b:1;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:5:"views";a:16:{s:18:"declaringClassName";s:27:"Sahil\Firefiber\FireAdapter";s:21:"implementingClassName";s:27:"Sahil\Firefiber\FireAdapter";s:4:"name";s:5:"views";s:9:"modifiers";i:132;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:33:"Sahil\Contracts\View\ViewContract";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:7:"default";a:2:{s:4:"code";s:4:"null";s:10:"attributes";a:6:{s:9:"startLine";i:33;s:7:"endLine";i:33;s:13:"startTokenPos";i:81;s:12:"startFilePos";i:1205;s:11:"endTokenPos";i:81;s:10:"endFilePos";i:1208;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:33;s:7:"endLine";i:33;s:11:"startColumn";i:9;s:9:"endColumn";i:52;s:10:"isPromoted";b:1;s:21:"declaredAtCompileT