 * Renders a server-driven UI component from a template.
 *
 * The template engine knows nothing about any particular component library:
 * a template may ask for a component by name and an implementation supplied
 * by the application (for example Firefiber) decides what that name means,
 * instantiates the component, and returns finished markup including any
 * hydration metadata the browser runtime needs.
 *
 * Binding this contract is optional. Templates that do not use `@component`
 * or `<fiber:component>` never resolve it.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:19;s:7:"endLine";i:35;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:1:{s:15:"renderComponent";a:20:{s:4:"name";s:15:"renderComponent";s:10:"parameters";a:2:{s:4:"name";a:14:{s:4:"name";s:4:"name";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:34;s:7:"endLine";i:34;s:11:"startColumn";i:37;s:9:"endColumn";i:48;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:10:"attributes";a:14:{s:4:"name";s:10:"attributes";s:7:"default";a:2:{s:4:"code";s:2:"[]";s:10:"attributes";a:6:{s:9:"startLine";i:34;s:7:"endLine";i:34;s:13:"startTokenPos";i:42;s:12:"startFilePos";i:1399;s:11:"endTokenPos";i:43;s:10:"endFilePos";i:1400;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:34;s:7:"endLine";i:34;s:11:"startColumn";i:51;s:9:"endColumn";i:72;s:14:"parameterIndex";i:1;s:10:"isOptional";b:1;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:628:"/**
 * Render one component instance.
 *
 * @param string $name Component name: a short class name (`Counter`) or a
 *                     fully-qualified class name (`App\Firefiber\Components\Counter`).
 * @param array<string, mixed> $attributes Component properties, keyed by
 *                     property name (kebab-case template attributes are
 *                     converted to camelCase before they arrive here).
 *
 * @throws \Throwable when the component cannot be resolved or rendered,
 *                    so an unknown component fails loudly instead of
 *                    leaving a marker in the response.
 */";s:9:"startLine";i:34;s:7:"endLine";i:34;s:11:"startColumn";i:5;s:9:"endColumn";i:82;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:20:"Sahil\Contracts\View";s:18:"declaringClassName";s:46:"Sahil\Contracts\View\ComponentRendererContract";s:21:"implementingClassName";s:46:"Sahil\Contracts\View\ComponentRendererContract";s:16:"currentClassName";s:46:"Sahil\Contracts\View\ComponentRendererContract";s:9:"aliasName";N;}}s:10:"traitsData";a:4:{s:7:"aliases";a:0:{}s:9:"modifiers";a:0:{}s:11:"precedences";a:0:{}s:6:"hashes";a:0:{}}}}