 * The view rendering API an application codes against.
 *
 * A caller hands in a template NAME (dotted or slashed, resolved through the
 * configured view directories) and a data map, and gets rendered markup back:
 *
 *     $html = $views->render('pages.home', ['title' => 'Home', 'posts' => $posts]);
 *     return Response::html($html);
 *
 * Everything else — escaping, inheritance, sections, partials, compilation
 * and caching — is the engine's business, and a template never receives the
 * caller's scope: it can only read the keys it was handed.
 *
 * Failures are typed, never silent: a missing template throws
 * {@see \Sahil\View\ViewNotFoundException}, a broken template throws
 * {@see \Sahil\View\ViewSyntaxException} (with template name and line), and a
 * template that compiles but cannot render throws
 * {@see \Sahil\View\ViewRenderException}. All three extend
 * {@see \Sahil\View\ViewException}.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:27;s:7:"endLine";i:59;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:4:{s:6:"render";a:20:{s:4:"name";s:6:"render";s:10:"parameters";a:2:{s:4:"view";a:14:{s:4:"name";s:4:"view";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:35;s:11:"startColumn";i:28;s:9:"endColumn";i:39;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:4:"data";a:14:{s:4:"name";s:4:"data";s:7:"default";a:2:{s:4:"code";s:2:"[]";s:10:"attributes";a:6:{s:9:"startLine";i:35;s:7:"endLine";i:35;s:13:"startTokenPos";i:42;s:12:"startFilePos";i:1263;s:11:"endTokenPos";i:43;s:10:"endFilePos";i:1264;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:35;s:7:"endLine";i:35;s:11:"startColumn";i:42;s:9:"endColumn";i:57;s:14:"parameterIndex";i:1;s:10:"isOptional";b:1;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:160:"/**
