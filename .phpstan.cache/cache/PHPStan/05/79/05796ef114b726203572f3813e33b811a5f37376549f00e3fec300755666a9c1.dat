 * Deterministic rule-based validator.
 *
 * Construction:
 *
 *     $validator = new Validator([
 *         'email' => 'required|email',
 *         'age' => 'nullable|integer|min:0|max:130',
 *         'user.name' => 'required|string',
 *         'role' => 'in:admin,editor',
 *         'code' => 'regex:/^[A-Z]{3}$/',
 *         'tags.*' => 'string',
 *     ]);
 *
 * Conventions (documented as API contract):
 *
 *  - Fields not mentioned in the rule map NEVER reach `validated()`:
 *    validated data is the only "accepted" shape, raw input never is.
 *  - `required` fails for missing / null / empty-string fields.
 *  - `nullable` lets missing / null fields skip the whole chain; without
 *    `required` a missing field passes silently (validates to nothing).
 *  - An empty string is a PRESENT value: it is judged by the chain (so
 *    `numeric` rejects `""`), only `required` treats it as missing.
 *  - A failing field stops its own chain at the first failure (no
 *    cascading garbage messages), other fields keep validating.
 *  - Type rules check strictly; the ONLY coercion is documented and
 *    lossless: `integer` accepts int or plain digit strings → int,
 *    `numeric` accepts int/float/numeric strings (digit strings stay
 *    int when lossless, otherwise float), `boolean` accepts real bools
 *    or the exact strings "true"/"false" → bool. No trimming, no
 *    "looks like" heuristics beyond these cases.
 *  - Strings containing control characters (NUL, C0 controls except
 *    \t\n\r, DEL, C1) fail the `string` rule unless the SAME rule set
 *    also contains `allowsControlChars`.
 *  - Normalization happens ONLY when explicitly configured via
 *    {@see normalize()} (currently `trim`); default judges raw input.
 *
 * Wildcards (`tags.*`) clone the rules onto every element of the parent
 * array at that nesting level; nested dot paths reach array children.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:51;s:7:"endLine";i:617;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:1:{s:15:"CONTROL_PATTERN";a:12:{s:18:"declaringClassName";s:26:"Sahil\Validation\Validator";s:21:"implementingClassName";s:26:"Sahil\Validation\Validator";s:4:"name";s:15:"CONTROL_PATTERN";s:9:"modifiers";i:4;s:4:"type";N;s:5:"value";a:2:{s:4:"code";s:50:"'/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F\x{80}-\x{9F}]/u'";s:10:"attributes";a:6:{s:9:"startLine";i:53;s:7:"endLine";i:53;s:13:"startTokenPos";i:48;s:12:"startFilePos";i:2095;s:11:"endTokenPos";i:48;s:10:"endFilePos";i:2144;}}s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:53;s:7:"endLine";i:53;s:11:"startColumn";i:5;s:9:"endColumn";i:87;}}s:19:"immediateProperties";a:3:{s:5:"rules";a:16:{s:18:"declaringClassName";s:26:"Sahil\Validation\Validator";s:21:"implementingClassName";s:26:"Sahil\Validation\Validator";s:4:"name";s:5:"rules";s:9:"modifiers";i:4;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:7:"default";N;s:10:"docComment";s:73:"/** @var array<string, string|array<int, string|Closure|RuleContract>> */";s:10:"attributes";a:0:{}s:9:"startLine";i:56;s:7:"endLine";i:56;s:11:"startColumn";i:5;s:9:"endColumn";i:25;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:8:"messages";a:16:{s:18:"declaringClassName";s:26:"Sahil\Validation\Validator";s:21:"implementingClassName";s:26:"Sahil\Validation\Validator";s:4:"name";s:8:"messages";s:9:"modifiers";i:4;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:7:"default";N;s:10:"docComment";s:33:"/** @var array<string, string> */";s:10:"attributes";a:0:{}s:9:"startLine