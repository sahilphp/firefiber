 * Registers Firefiber's request middleware and package-managed browser
 * assets with a SahilPHP application.
 *
 * Register this provider in the application's `bootstrap/providers.php`.
 * The framework has no Composer auto-discovery mechanism, so no package can
 * silently add a provider or an asset route to an application.
 *
 * The provider also registers the secure action endpoint, discovers
 * conventional application pages, and renders their components.
 *
 * Assets are served from the installed package through a fixed route. No
 * Composer install script and no provider boot step copies files into the
 * consumer's `public/`, `resources/` or any other application directory.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:44;s:7:"endLine";i:368;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:32:"Sahil\Foundation\ServiceProvider";s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:7:{s:8:"register";a:20:{s:4:"name";s:8:"register";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:46;s:7:"endLine";i:255;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:15:"Sahil\Firefiber";s:18:"declaringClassName";s:40:"Sahil\Firefiber\FirefiberServiceProvider";s:21:"implementingClassName";s:40:"Sahil\Firefiber\FirefiberServiceProvider";s:16:"currentClassName";s:40:"Sahil\Firefiber\FirefiberServiceProvider";s:9:"aliasName";N;}s:4:"boot";a:20:{s:4:"name";s:4:"boot";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"void";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:257;s:7:"endLine";i:280;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:15:"Sahil\Firefiber";s:18:"declaringClassName";s:40:"Sahil\Firefiber\FirefiberServiceProvider";s:21:"implementingClassName";s:40:"Sahil\Firefiber\FirefiberServiceProvider";s:16:"currentClassName";s:40:"Sahil\Firefiber\FirefiberServiceProvider";s:9:"aliasName";N;}s:20:"registerAssetAliases";a:20:{s:4:"name";s:20:"registerAssetAliases";s:10:"parameters";a:1:{s:9:"container";a:14:{s: