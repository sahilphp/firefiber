 * Derives the keys used by the secure action protocol.
 *
 * The master key is server-only. It is either the configured
 * `FIREFIBER_HMAC_KEY` or an HMAC derived from the application key, so a
 * fresh SahilPHP installation does not need a second secret when it has
 * already generated an application key.
 *
 * Rendered pages do not receive any signing secret. The session-bound
 * client key remains as a legacy helper for optional body-integrity
 * signatures, but it is never rendered to the browser and it cannot be used
 * to sign snapshots or authorize component actions.
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:24;s:7:"endLine";i:56;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";N;s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:2:{s:9:"masterKey";a:20:{s:4:"name";s:9:"masterKey";s:10:"parameters";a:1:{s:11:"application";a:14:{s:4:"name";s:11:"application";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:46:"Sahil\Contracts\Foundation\ApplicationContract";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0:{}s:9:"startLine";i:26;s:7:"endLine";i:26;s:11:"startColumn";i:38;s:9:"endColumn";i:69;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";N;s:9:"startLine";i:26;s:7:"endLine";i:43;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:1;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:17;s:9:"namespace";s:15:"Sahil\Firefiber";s:18:"declaringClassName";s:32:"Sahil\Firefiber\FirefiberSecrets";s:21:"implementingClassName";s:32:"Sahil\Firefiber\FirefiberSecrets";s:16:"currentClassName";s:32:"Sahil\Firefiber\FirefiberSecrets";s:9:"aliasName";N;}s:9:"clientKey";a:20:{s:4:"name";s:9:"clientKey";s:10:"parameters";a:2:{s:11:"application";a:14:{s:4:"name";s:11:"application";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:46:"Sahil\Contracts\Foundation\ApplicationContract";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"docComment";N;s:10:"attributes";a:0