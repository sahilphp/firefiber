# Composer and GitHub release archives include the built browser assets.
# Keep `dist/`, `css/` and `js/` in the archive: the first holds production
# outputs, the others are readable sources used for diagnostics and aliases.
/tests export-ignore
/.github export-ignore
/.phpunit.result.cache export-ignore
/debug6_click.php export-ignore
/phpunit.json export-ignore
/phpunit-src.zip export-ignore
/phpunit.phar export-ignore
/vendor export-ignore
/node_modules export-ignore
